# Copy to .env.local for local development.
# Leave VITE_API_BASE_URL unset (or VITE_ENV=mock) to run entirely against
# mock data — no real customer/order/financial data is reachable that way.

# Base URL of the deployed API Gateway stage, e.g. https://api.admin.ljwebmanagement.com
VITE_API_BASE_URL=

# mock | staging | production
VITE_ENV=mock
